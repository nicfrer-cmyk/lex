# ============================================================================
# LexTrack — משתני סביבה
# ============================================================================
#
# קובץ זה הוא **תבנית בלבד**. אין בו ואסור שיהיו בו ערכים אמיתיים.
# .env ו-.env.local כבר ב-.gitignore.
#
# חשוב להבין את החלוקה: כמעט כל המשתנים כאן הם **secrets של Supabase**, לא
# משתני build של Netlify. הם נקראים ע"י Edge Functions בלבד, ולעולם לא
# מגיעים לדפדפן. הגדרה:
#
#   supabase secrets set NAME=value
#   supabase secrets list          # לבדיקה מה כבר מוגדר
#
# היחיד שכן חי בצד הלקוח הוא ה-anon key, והוא כבר ב-src/supabase-config.js —
# הוא מיועד להיות פומבי, וה-RLS הוא מה שמגן על הנתונים.
# ============================================================================


# ----------------------------------------------------------------------------
# ליבה — מוזרק אוטומטית ע"י Supabase לכל Edge Function. אין להגדיר ידנית.
# ----------------------------------------------------------------------------
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY     ← מפתח על. לעולם לא בדפדפן, לעולם לא ב-git.


# ----------------------------------------------------------------------------
# ספק AI — חובה
# ----------------------------------------------------------------------------
# מפתח Anthropic של המשרד. משמש גם את ai-proxy הקיים וגם את מרכז ה-AI החדש.
# בלעדיו מרכז ה-AI עובר אוטומטית ל-MockProvider ולא שולח דבר.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# mock = אף קריאה אמיתית לא נשלחת ואין עלות. שימושי לבדיקת כל הזרימה
#        (job → worker → כלי → אישור) בלי לשרוף כסף.
# live = קריאות אמיתיות.
# ניתן לעקוף לכל משרד בנפרד דרך ai_settings.ai_provider_mode במסך ההגדרות.
AI_PROVIDER_MODE=live


# ----------------------------------------------------------------------------
# הצפנת credentials של אינטגרציות — חובה אם משתמשים ב-Gmail/יומן
# ----------------------------------------------------------------------------
# מפתח AES-256-GCM שבו מוצפנים refresh tokens בעמודה
# integration_connections.encrypted_credentials.
#
# ⚠ שינוי המפתח הזה הופך כל חיבור קיים לבלתי ניתן לפענוח — כל המשרדים
#   יצטרכו לחבר מחדש את Google. יש לייצר אותו פעם אחת ולשמור בבטחה.
#
# ייצור:  openssl rand -base64 48
INTEGRATION_ENCRYPTION_KEY=


# ----------------------------------------------------------------------------
# תזמון — נדרש כדי שהמערכת תעבוד גם כשהמחשב כבוי
# ----------------------------------------------------------------------------
# סוד משותף שמאמת את מי שקורא ל-ai-cron. הפונקציה נפרסת עם --no-verify-jwt
# (למתזמן אין משתמש מחובר), ולכן זו ההגנה היחידה עליה.
# בלי הערך הזה — ai-cron דוחה כל בקשה שאינה עם service_role key.
#
# ייצור:  openssl rand -hex 32
CRON_SECRET=

# כתובת האתר — לחזרה אחרי OAuth ולקישורים בהתראות.
SITE_URL=https://zesty-marigold-0edcb2.netlify.app


# ----------------------------------------------------------------------------
# Google — Gmail + יומן  (רשות; בלעדיהם המצב הוא mock ו-UI מציג "לא מוגדר")
# ----------------------------------------------------------------------------
# הקמה: console.cloud.google.com → פרויקט חדש → Enable APIs (Gmail API,
# Google Calendar API) → OAuth consent screen → Credentials → OAuth client ID
# (Web application).
#
# Authorized redirect URI — חייב להיות בדיוק:
#   https://<PROJECT-REF>.supabase.co/functions/v1/integrations-google?action=callback
#
# ⚠ זהו OAuth **נפרד** מזה של Supabase Auth שמשמש להתחברות עם Google.
#   לזרימת ההתחברות אין את ה-scopes של Gmail ואין refresh token שמור.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ----------------------------------------------------------------------------
# WhatsApp Business Cloud API  (רשות)
# ----------------------------------------------------------------------------
# הקמה: developers.facebook.com → אפליקציה → WhatsApp → API Setup.
#
# Webhook URL להגדרה אצל Meta:
#   https://<PROJECT-REF>.supabase.co/functions/v1/webhook-whatsapp
WHATSAPP_PROVIDER_MODE=mock

# Permanent access token (System User token — לא הזמני של 24 שעות).
WHATSAPP_TOKEN=

# מזהה מספר הטלפון העסקי. חייב להיות שמור גם ב-
# integration_connections.account_identifier, אחרת webhook נכנס לא יזוהה
# לאיזה משרד הוא שייך והוא יידחה.
WHATSAPP_PHONE_NUMBER_ID=

# מחרוזת שאתה בוחר; Meta שולחת אותה ב-GET לאימות ה-webhook.
WHATSAPP_VERIFY_TOKEN=

# App Secret מהגדרות האפליקציה ב-Meta. משמש לאימות חתימת HMAC של כל POST.
# ⚠ בלעדיו webhook-whatsapp דוחה **כל** בקשה (503) — במכוון: endpoint פומבי
#   בלי אימות חתימה מאפשר לכל אחד להזריק "הודעות" ולידים מזויפים.
WHATSAPP_APP_SECRET=


# ----------------------------------------------------------------------------
# טלפוניה  (טרם נבחר ספק — החלטה עסקית של בעל המשרד)
# ----------------------------------------------------------------------------
# הקוד מוכן (interface + webhook גנרי), אבל אין מימוש ספק ספציפי בכוונה.
# מסך החיבורים מציג "נדרש חיבור ספק טלפוניה" ואת רשימת הדרישות המלאה.
#
# ההגדרה לכשייבחר ספק נעשית **בנתונים ולא בקוד**: שורה ב-
# integration_connections עם provider='telephony' ו-config שמכיל
# webhook_secret, signature_scheme ו-field_map. ראה AI_CENTER_INTEGRATIONS.md.
TELEPHONY_PROVIDER_MODE=mock


# ----------------------------------------------------------------------------
# קיימים מלפני מרכז ה-AI — לא לשנות
# ----------------------------------------------------------------------------
# VAPID_KEYS      — התראות Push (check-and-send-reminders)
# RESEND_API_KEY  — שליחת הזמנות לצוות (send-invite-email)
# GROW_*          — סליקה (grow-webhook)
EMAIL_PROVIDER_MODE=mock


# ----------------------------------------------------------------------------
# מרכז שיחות — המזכירה הדיגיטלית  (docs/AI_CALL_CENTER.md)
# ----------------------------------------------------------------------------
# המספר הציבורי של המשרד. נשמר גם ב-call_center_settings וניתן לעריכה
# במסך; הערך כאן הוא ברירת המחדל בלבד.
PUBLIC_OFFICE_PHONE=0552745790

# ⚠ סוד החתימה בין שרת הקול לבין ה-CRM (HMAC-SHA256).
#   חייב להיות **זהה בדיוק** לערך שב-services/voice-gateway/.env.
#   בלעדיו voice-gateway דוחה כל בקשה ב-503 — במכוון: endpoint טלפוניה
#   פומבי בלי אימות מאפשר לכל אחד להזריק שיחות ולידים מזויפים.
#
#   ייצור:  openssl rand -hex 32
VOICE_GATEWAY_SECRET=

# כתובת שרת הקול. לתצוגה במסך "מצב מערכת" בלבד — ה-CRM לא יוזם אליו
# קריאות; שרת הקול הוא שפונה ל-CRM.
VOICE_GATEWAY_URL=

# ⚠ יעד ההעברה לנציג אנושי.
#   **אסור** שיהיה זהה ל-PUBLIC_OFFICE_PHONE: אם השיחה מופנית מהמספר
#   הציבורי אל ה-AI, העברה חזרה אליו יוצרת לולאת Call Forwarding —
#   ערוצים שנפתחים עד קריסה, וחיוב על כל אחד.
#   כל עוד ריק: הכלי transfer_call מסומן לא-זמין ונוצרת משימת חזרה
#   במקום העברה. זו ההתנהגות הנכונה, לא עקיפה.
HUMAN_TRANSFER_NUMBER=

# ⚠ כבוי כברירת מחדל ובמכוון. הקלטת שיחה כפופה לחוק האזנת סתר ולכללי
#   האתיקה של לשכת עורכי הדין. ההפעלה היא החלטה מפורשת של בעל המשרד,
#   ונעשית במסך ההגדרות ולא כאן.
CALL_RECORDING_ENABLED=false

# משתני SIP ו-Asterisk **אינם** כאן: הם שייכים לשרת הקול בלבד ולא
# ל-Supabase. ראה services/voice-gateway/.env.example — SIP_HOST,
# SIP_PORT, SIP_USERNAME, SIP_PASSWORD, SIP_TRANSPORT, ARI_*,
# MEDIA_TRANSPORT, LOCAL_LLM_URL, LOCAL_STT_URL, LOCAL_TTS_URL.

# ⚠ קבלת שיחות אמיתיות **אינה** משתנה סביבה, ובכוונה.
#   היא שדה במסד הנתונים (call_center_settings.live_calls_enabled),
#   ברירת מחדל false, וההפעלה נעשית ע"י בעל המשרד במסך "מצב מערכת"
#   אחרי בדיקת מוכנות שעוברת. משתנה סביבה היה מאפשר להדליק אותה
#   ב-deploy בלי שאיש יבדוק אם יש בכלל מנוע הקראה — וזה בדיוק המצב
#   שבו הלקוח הראשון מקשיב לשקט.
