# ============================================================================
# Voice Gateway — משתני סביבה
# ============================================================================
#
# קובץ זה הוא **תבנית בלבד**. אין בו ואסור שיהיו בו ערכים אמיתיים.
# העתק ל-.env (שנמצא ב-.gitignore) ומלא שם.
#
#   cp .env.example .env
#
# בלי VOICE_GATEWAY_SECRET ו-CRM_BASE_URL השירות עולה אך אינו מתחבר ל-CRM
# ומדווח על עצמו כלא-מוגדר. זה מכוון.
# ============================================================================


# ----------------------------------------------------------------------------
# חיבור ל-CRM — חובה
# ----------------------------------------------------------------------------
# כתובת ה-Edge Function של מרכז השיחות.
#   https://<PROJECT-REF>.supabase.co/functions/v1/voice-gateway
CRM_BASE_URL=

# מזהה המשרד (uuid מטבלת offices). נשלח בכותרת X-Voice-Office.
CRM_OFFICE_ID=

# ⚠ הסוד המשותף שבו נחתמת כל בקשה (HMAC-SHA256).
#   חייב להיות **זהה** לערך שהוגדר ב-Supabase:
#     supabase secrets set VOICE_GATEWAY_SECRET=<אותו ערך>
#   ייצור:  openssl rand -hex 32
#   בלעדיו כל בקשה נדחית ב-401 — endpoint טלפוניה פומבי בלי אימות מאפשר
#   לכל אחד להזריק שיחות ולידים מזויפים למשרד עורכי דין.
VOICE_GATEWAY_SECRET=

# כל כמה שניות נשלח heartbeat. ה-CRM מציג "מחובר" רק אם התקבל heartbeat
# ב-60 השניות האחרונות — אין דגל "online" שמור, כדי ששרת שנפל לא יישאר
# ירוק במסך.
HEARTBEAT_INTERVAL_SECONDS=30


# ----------------------------------------------------------------------------
# המספר הציבורי
# ----------------------------------------------------------------------------
PUBLIC_OFFICE_PHONE=0552745790

# ⚠ יעד ההעברה לנציג אנושי. **אסור** שיהיה זהה ל-PUBLIC_OFFICE_PHONE:
# אם השיחה הופנתה מהמספר הציבורי אל ה-AI, העברה חזרה אליו יוצרת לולאת
# Call Forwarding. כל עוד השדה ריק — הכלי transfer_call מסומן כלא-זמין
# וה-CRM יוצר משימת חזרה במקומו.
HUMAN_TRANSFER_NUMBER=


# ----------------------------------------------------------------------------
# SIP — טרם הוגדר ספק
# ----------------------------------------------------------------------------
# placeholders בלבד. מילוי הערכים כאן הוא מה שהופך את הקו לחי — אין לעשות
# זאת לפני שהספק נבחר והקו נבדק.
SIP_HOST=
SIP_PORT=5060
SIP_USERNAME=
SIP_PASSWORD=
SIP_TRANSPORT=udp
# הדומיין שהספק מצפה לראות ב-From. לרוב זהה ל-SIP_HOST.
SIP_REALM=
# כתובת ה-IP הפומבית של השרת. נדרשת כש-Asterisk מאחורי NAT — בלעדיה
# ה-SDP מפרסם כתובת פנימית והאודיו "נעלם" בכיוון אחד.
SIP_EXTERNAL_IP=


# ----------------------------------------------------------------------------
# Asterisk ARI
# ----------------------------------------------------------------------------
ARI_HOST=asterisk
ARI_PORT=8088
ARI_USERNAME=voicegw
# ייצור:  openssl rand -hex 24
ARI_PASSWORD=
ARI_APP_NAME=lextrack-voice

# הפורט שאליו Asterisk מזרים אודיו (External Media).
EXTERNAL_MEDIA_HOST=orchestrator
EXTERNAL_MEDIA_PORT=8090
# slin16 = PCM 16-bit little-endian, 16kHz — הפורמט ש-STT מקומי מצפה לו.
EXTERNAL_MEDIA_FORMAT=slin16

# ערוץ המדיה: audiosocket | websocket
#
# ⚠ websocket הוא **שלד בלבד**. הוא מצהיר production_ready=false, ומנוע
#   המוכנות ב-CRM יחסום הפעלת שיחות אמיתיות מעליו — כלומר Asterisk יתחבר,
#   השיחה תיענה, ואיש לא ישמע דבר. יש להשאיר audiosocket עד שיושלם.
MEDIA_TRANSPORT=audiosocket


# ----------------------------------------------------------------------------
# ספקים — ברירת המחדל היא Self-Hosted
# ----------------------------------------------------------------------------
# STT: mock | faster_whisper
STT_PROVIDER=mock
LOCAL_STT_URL=
# tiny/base/small/medium/large-v3. small הוא האיזון הסביר לעברית על CPU.
STT_MODEL=small
STT_LANGUAGE=he
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# LLM: crm | mock | ollama | vllm
#
# ⚠ ברירת המחדל היא crm, וזו החלטה ולא עצלות: הסוכן, הכלים, ההרשאות
#   וכללי הדחיפות חיים ב-CRM. הרצת מודל כאן הייתה יוצרת מערכת שנייה
#   שצריך לתחזק במקביל — ובדיוק הפיצול שהמפרט אוסר בסימולטור.
#   ollama/vllm שמורים למקרה שבו נדרשת השהיה נמוכה מקומית.
LLM_PROVIDER=crm
LOCAL_LLM_URL=
LLM_MODEL=

# TTS: mock | local
#
# ⚠ לא נבחר מנוע TTS עברי. אין להמציא אחד. mock מייצר שקט באורך הנכון
#   ומדווח על עצמו כ-mock — כך שהזרימה נבדקת מקצה לקצה בלי להעמיד פנים
#   שיש קול. כשייבחר מנוע: LOCAL_TTS_URL + TTS_PROVIDER=local.
TTS_PROVIDER=mock
LOCAL_TTS_URL=
TTS_VOICE=


# ----------------------------------------------------------------------------
# הקלטות
# ----------------------------------------------------------------------------
# ⚠ כבוי כברירת מחדל ובמכוון. הקלטת שיחה כפופה לחוק האזנת סתר ולכללי
#   האתיקה של לשכת עורכי הדין. ההפעלה היא החלטה מפורשת של בעל המשרד.
CALL_RECORDING_ENABLED=false
RECORDING_PATH=/var/spool/lextrack/recordings


# ----------------------------------------------------------------------------
# תפעול
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
# תור מקומי לבקשות שלא הצליחו להגיע ל-CRM. שיחה לא נעצרת בגלל תקלת רשת;
# הבקשה נשמרת ונשלחת שוב. האידמפוטנטיות בצד ה-CRM היא מה שהופך את זה
# לבטוח — אותה פעולה לא תיצור שתי פגישות.
# ⚠ נתיב ה-Outbox. מאז ההקשחה זהו קובץ SQLite (outbox.db) ולא קבצי JSON:
#   הוא שורד restart, ומאפשר ספירה, סדר וניקוז בלי סריקת תיקייה.
#   פעולה ב-dead_letter **אינה נמחקת** — היא פנייה של לקוח שלא נרשמה.
QUEUE_PATH=/var/spool/lextrack/queue
QUEUE_MAX_RETRIES=8
HTTP_TIMEOUT_SECONDS=20
MAX_CONCURRENT_CALLS=4
